# Blockchain Configuration
BLOCKCHAIN=ethereum  # ethereum, polygon, bsc, arbitrum
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
PRIVATE_KEY=your_private_key_here_NEVER_COMMIT_THIS

# Exchange Configuration
EXCHANGE_TYPE=dex  # dex or cex
DEX_TYPE=uniswap  # uniswap, pancakeswap, curve
CEX_API_KEY=your_cex_api_key
CEX_API_SECRET=your_cex_api_secret

# Trading Configuration
TRADING_PAIR=USDC/ETH
STRATEGY=dca  # dca, arbitrage, technical_analysis
TRADE_AMOUNT=100  # en USDC
TRADE_INTERVAL=3600  # en secondes (1 heure)
MIN_PROFIT_PERCENT=2  # pour l'arbitrage

# Alerts Configuration
ALERT_TYPE=telegram  # telegram, discord, email, all
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK=your_discord_webhook_url
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient@gmail.com

# Logger Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Dashboard Configuration
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0

# Safety Limits
MAX_DAILY_LOSS_PERCENT=5
MAX_TRANSACTION_AMOUNT=10000
STOP_LOSS_PERCENT=3